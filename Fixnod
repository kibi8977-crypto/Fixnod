            tooltip.Position = UDim2.new(0, x, 0, y)
            tooltip.Visible = true
        end)
    end)
end

local function hideTooltip()
    ttToken = ttToken + 1
    tooltip.Visible = false
end

local function attachTooltip(row, label, desc)
    if not desc or #desc == 0 then return end
    row.MouseEnter:Connect(function() showTooltip(label, desc) end)
    row.MouseLeave:Connect(hideTooltip)
end


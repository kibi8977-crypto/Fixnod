--=============================================================
-- MATH
--=============================================================
local function hsvToRgb(h, s, v)
    h = h % 1
    local i = math.floor(h * 6)
    local f = h * 6 - i
    local p = v * (1 - s)
    local q = v * (1 - f * s)
    local t = v * (1 - (1 - f) * s)
    local m = i % 6
    if m == 0 then return Color3.new(v, t, p)
    elseif m == 1 then return Color3.new(q, v, p)
    elseif m == 2 then return Color3.new(p, v, t)
    elseif m == 3 then return Color3.new(p, q, v)
    elseif m == 4 then return Color3.new(t, p, v)
    else return Color3.new(v, p, q) end
end

local function lerp(a, b, t) return a + (b - a) * t end
local function lerpColor(a, b, t) return Color3.new(lerp(a.R,b.R,t), lerp(a.G,b.G,t), lerp(a.B,b.B,t)) end
local function lerpUDim2(a, b, t)
    return UDim2.new(
        lerp(a.X.Scale, b.X.Scale, t), lerp(a.X.Offset, b.X.Offset, t),
        lerp(a.Y.Scale, b.Y.Scale, t), lerp(a.Y.Offset, b.Y.Offset, t))
end
local function lighten(c, a) return Color3.new(math.min(1,c.R+a), math.min(1,c.G+a), math.min(1,c.B+a)) end

--=============================================================
-- SPRING ENGINE — menu scale/position mượt kiểu vật lý
--=============================================================
local Springs = {}

local function newSpring(initial, k, d)
    local s = {value = initial, target = initial, vel = 0, k = k or 180, d = d or 16}
    table.insert(Springs, s)
    return s
end

local function tickSprings(dt)
    for _, s in ipairs(Springs) do
        local a = -s.k * (s.value - s.target) - s.d * s.vel
        s.vel = s.vel + a * dt
        s.value = s.value + s.vel * dt
    end
end

--=============================================================
-- LERP ANIMATOR — cho hover / color / size
--=============================================================
local Anims = {}

local function anim(obj, prop, target, speed)
    for _, a in ipairs(Anims) do
        if a.obj == obj and a.prop == prop then
            a.target = target
            if speed then a.speed = speed end
            return
        end
    end
    table.insert(Anims, {obj = obj, prop = prop, target = target, speed = speed or 14})
end

local function tickAnims(dt)
    for i = #Anims, 1, -1 do
        local a = Anims[i]
        if not a.obj.Parent then
            table.remove(Anims, i)
        else
            local cur = a.obj[a.prop]
            local t = math.min(1, a.speed * dt)
            local tp = typeof(cur)
            if tp == "number" then
                local nv = lerp(cur, a.target, t)
                if math.abs(nv - a.target) < 0.002 then
                    a.obj[a.prop] = a.target
                    table.remove(Anims, i)
                else
                    a.obj[a.prop] = nv
                end
            elseif tp == "Color3" then
                local nv = lerpColor(cur, a.target, t)
                if math.abs(nv.R - a.target.R) < 0.004
                and math.abs(nv.G - a.target.G) < 0.004
                and math.abs(nv.B - a.target.B) < 0.004 then
                    a.obj[a.prop] = a.target
                    table.remove(Anims, i)
                else
                    a.obj[a.prop] = nv
                end
            elseif tp == "UDim2" then
                a.obj[a.prop] = lerpUDim2(cur, a.target, t)
            end
        end
    end
end


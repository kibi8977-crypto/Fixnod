--=============================================================
-- UTIL
--=============================================================
local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function corner(p, r) return new("UICorner", {CornerRadius = UDim.new(0, r or 8)}, p) end
local function stroke(p, c, t, tr)
    return new("UIStroke", {
        Color = c or CONFIG.Accent, Thickness = t or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = tr or 0.4,
    }, p)
end
local function gradient(p, c1, c2, rot)
    return new("UIGradient", {
        Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, c1),
            ColorSequenceKeypoint.new(0.5, c2),
            ColorSequenceKeypoint.new(1, c1),
        },
        Rotation = rot or 45,
    }, p)
end

local function makeTriGradient(c1, c2)
    return ColorSequence.new{
        ColorSequenceKeypoint.new(0, c1),
        ColorSequenceKeypoint.new(0.5, c2),
        ColorSequenceKeypoint.new(1, c1),
    }
end

--=============================================================
-- THEME BINDINGS
--=============================================================
local Bindings = {accent = {}, accent2 = {}, toggle = {}, gradientFills = {}, gradientStrokes = {}}
local function bindAccent(o, p) table.insert(Bindings.accent, {obj = o, prop = p}) end
local function bindAccent2(o, p) table.insert(Bindings.accent2, {obj = o, prop = p}) end
local function bindToggle(t, k, key) table.insert(Bindings.toggle, {toggle = t, knob = k, key = key}) end
local function bindGradientFill(g) table.insert(Bindings.gradientFills, g) end
local function bindGradientStroke(g) table.insert(Bindings.gradientStrokes, g) end

local ESP_RefreshColors

local function applyTheme()
    for _, b in ipairs(Bindings.accent) do
        if b.obj.Parent then b.obj[b.prop] = CONFIG.Accent end
    end
    for _, b in ipairs(Bindings.accent2) do
        if b.obj.Parent then b.obj[b.prop] = CONFIG.Accent2 end
    end
    for _, t in ipairs(Bindings.toggle) do
        if t.toggle.Parent then
            local on = State[t.key] == true
            t.toggle.BackgroundColor3 = on and CONFIG.Accent or Color3.fromRGB(40, 34, 70)
            t.knob.BackgroundColor3 = on and Color3.fromRGB(255,255,255) or Color3.fromRGB(120,110,160)
        end
    end
    local gradSeq = makeTriGradient(CONFIG.Accent, CONFIG.Accent2)
    for _, g in ipairs(Bindings.gradientFills) do
        if g.Parent then g.Color = gradSeq end
    end
    for _, g in ipairs(Bindings.gradientStrokes) do
        if g.Parent then g.Color = gradSeq end
    end
    if ESP_RefreshColors then ESP_RefreshColors() end
end


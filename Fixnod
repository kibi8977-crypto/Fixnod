        AutoButtonColor = false, ZIndex = 4,
        ClipsDescendants = true,
    }, parent)
    corner(btn, 7)
    btn:SetAttribute("SearchLabel", label)
    local baseCol = color
    btn.MouseEnter:Connect(function()
        anim(btn, "BackgroundColor3", baseCol:Lerp(Color3.new(1,1,1), 0.15), 16)
    end)
    btn.MouseLeave:Connect(function()
        anim(btn, "BackgroundColor3", baseCol, 16)
    end)
    btn.MouseButton1Click:Connect(function()
        pcall(function()
            local mp = UserInputService:GetMouseLocation()
            local relX = mp.X - btn.AbsolutePosition.X
            local relY = mp.Y - btn.AbsolutePosition.Y
            createRipple(btn, relX, relY)
        end)
        callback()
    end)
    return btn
end


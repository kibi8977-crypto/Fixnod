--=============================================================
-- DISPATCHER
--=============================================================
local acc = {
    orbs = 0, stars = 0, title = 0, border = 0, banner = 0,
    rainbow = 0, galaxy = 0, esp = 0, ping = 0,
    fpsTimer = 0, fpsUpdate = 0, session = 0, wm = 0, pulse = 0,
}
local frameCount = 0
local orbitTime = 0
local bannerTime = 0
local pulseTime = 0
local titleTime = 0

local ORB_RATE      = 1/30
local STAR_RATE     = 0.8
local TITLE_RATE    = 1/30
local BORDER_RATE   = 1/60
local BANNER_RATE   = 1/40
local RAINBOW_RATE  = 1/20
local GALAXY_RATE   = 1/20
local ESP_RATE      = 1/60
local FPS_RATE      = 0.5
local PING_RATE     = 2
local SESSION_RATE  = 1
local WM_RATE       = 0.25
local PULSE_RATE    = 1/40

local lastESPState = false

local function dispatcher(dt)
    -- core systems
    tickSprings(dt)
    tickAnims(dt)

    -- menu scale từ spring
    if mainScale.Scale ~= menuSpring.value then
        mainScale.Scale = menuSpring.value
    end
    -- auto close khi spring về 0
    if menuSpring.target == 0 and menuSpring.value < 0.02 then
        if main.Visible then main.Visible = false end
        menuSpring.value = 0
        menuSpring.vel = 0
    end

    frameCount = frameCount + 1
    acc.fpsTimer = acc.fpsTimer + dt
    if acc.fpsTimer >= 1 then
        State.FPS = frameCount
        frameCount = 0
        acc.fpsTimer = 0
    end

    acc.fpsUpdate = acc.fpsUpdate + dt
    if acc.fpsUpdate >= FPS_RATE then
        acc.fpsUpdate = 0
        if State.MenuVisible then updateFpsDisplay() end
    end

    acc.ping = acc.ping + dt
    if acc.ping >= PING_RATE then
        acc.ping = 0
        pcall(function()
            State.Ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
    end

    acc.session = acc.session + dt
    if acc.session >= SESSION_RATE then
        acc.session = 0
        if State.MenuVisible then updateSessionTimer() end
    end

    if State.WatermarkOn then
        acc.wm = acc.wm + dt
        if acc.wm >= WM_RATE then
            acc.wm = 0
            wmInfo.Text = string.format("%d FPS  %d ms  %s",
                State.FPS, State.Ping, fmtTime(now() - SESSION_START))
        end
    end

    -- pulse ring quanh avatar
    if State.MenuVisible then
        acc.pulse = acc.pulse + dt
        if acc.pulse >= PULSE_RATE then
            acc.pulse = 0
            pulseTime = pulseTime + PULSE_RATE
            local s = 1 + math.sin(pulseTime * 2.5) * 0.08
            local op = 0.4 + math.sin(pulseTime * 2.5) * 0.3
            pulseStroke.Transparency = op
        end
    end

    if State.MenuVisible then
        if State.EffectsOn then
            -- orbs
            acc.orbs = acc.orbs + dt
            if acc.orbs >= ORB_RATE then
                acc.orbs = 0
                orbitTime = orbitTime + ORB_RATE
                for i = 1, #orbs do
                    local o = orbs[i]
                    local phase = o.basePhase + orbitTime * 0.25
                    o.frame.Position = UDim2.new(
                        0.5 + math.cos(phase) * o.radius, -o.size/2,
                        0.5 + math.sin(phase * 0.7) * o.radius, -o.size/2)
                    o.gradient.Rotation = (o.gradient.Rotation + 2.4) % 360
                end
            end
            -- stars
            acc.stars = acc.stars + dt
            if acc.stars >= STAR_RATE then
                acc.stars = 0
                for i = 1, #stars do
                    local s = stars[i]
                    if s.Parent then s.BackgroundTransparency = math.random(20, 90) / 100 end
                end
            end
            -- title
            acc.title = acc.title + dt
            if acc.title >= TITLE_RATE then
                acc.title = 0
                titleTime = titleTime + TITLE_RATE
                titleGradient.Offset = Vector2.new(-(titleTime * 0.15) % 1, 0)
                titleGradient.Rotation = math.sin(titleTime * 0.8) * 8
            end
            -- border
            acc.border = acc.border + dt
            if acc.border >= BORDER_RATE then
                acc.border = 0
                mainStrokeGrad.Rotation = (mainStrokeGrad.Rotation + 1.5) % 360
            end
            -- banner stripes
            acc.banner = acc.banner + dt
            if acc.banner >= BANNER_RATE then
                acc.banner = 0
                bannerTime = bannerTime + BANNER_RATE
                for i = 1, #bannerStripes do
                    local s = bannerStripes[i]
                    local base = (i - 1) / #bannerStripes
                    local pos = (base + bannerTime * 0.12) % 1
                    s.Position = UDim2.new(pos, 0, 0, 0)
                end
            end
        end
        if CONFIG.RainbowMenu then
            acc.rainbow = acc.rainbow + dt
            if acc.rainbow >= RAINBOW_RATE then
                acc.rainbow = 0
                local t = now()
                CONFIG.Accent = hsvToRgb((t * CONFIG.RainbowSpeed) % 1, 0.65, 1)
                CONFIG.Accent2 = hsvToRgb((t * CONFIG.RainbowSpeed + 0.5) % 1, 0.65, 1)
                applyTheme()
                if menuPreview and menuPreview.Parent then syncPreview() end
            end
        end
    end

    -- ESP
    if State.ESP then
        acc.esp = acc.esp + dt
        if acc.esp >= ESP_RATE then
            acc.esp = 0
            for _, plr in ipairs(Players:GetPlayers()) do
                local d = ESP_DATA[plr] or ensureESPFrames(plr)
                local ok, err = pcall(updatePlayerESP, plr, d)
                if not ok and not d.warned then
                    d.warned = true
                    warn("[GalaxyESP v3.11] " .. plr.Name .. " -> " .. tostring(err))
                end
            end
        end
        if State.ESPGalaxyName then
            acc.galaxy = acc.galaxy + dt
            if acc.galaxy >= GALAXY_RATE then
                acc.galaxy = 0
                local t = now()
                for _, d in pairs(ESP_DATA) do
                    if d.name and d.name.Visible then
                        local hue = (t * CONFIG.GalaxySpeed + d.hueOffset) % 1
                        d.name.TextColor3 = hsvToRgb(hue, 0.75, 1)
                    end
                end
            end
        end
        lastESPState = true
    elseif lastESPState then
        for _, d in pairs(ESP_DATA) do hidePlayerESP(d) end
        lastESPState = false
    end
end


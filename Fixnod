local toastOrder = 0

local function toast(title, text, dur, color)
    dur = dur or 3
    color = color or CONFIG.Accent
    toastOrder = toastOrder + 1
    pcall(function()
        local card = new("Frame", {
            Size = UDim2.new(1, 0, 0, 54),
            Position = UDim2.new(1, 60, 0, 0),
            BackgroundColor3 = Color3.fromRGB(18, 16, 34),
            BorderSizePixel = 0,
            ZIndex = 101,
            LayoutOrder = toastOrder,
        }, toastHolder)
        corner(card, 9)
        local cardStroke = stroke(card, color, 1.4, 0.2)

        local bar = new("Frame", {
            Size = UDim2.new(0, 3, 1, -12),
            Position = UDim2.new(0, 0, 0, 6),
            BackgroundColor3 = color,
            BorderSizePixel = 0, ZIndex = 102,
        }, card)
        corner(bar, 2)

        new("TextLabel", {
            Size = UDim2.new(1, -20, 0, 16),
            Position = UDim2.new(0, 12, 0, 8),
            BackgroundTransparency = 1,
            Text = title, TextColor3 = CONFIG.Text,
            Font = Enum.Font.GothamBold, TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 102,
        }, card)

        new("TextLabel", {
            Size = UDim2.new(1, -20, 0, 20),
            Position = UDim2.new(0, 12, 0, 26),
            BackgroundTransparency = 1,
            Text = text, TextColor3 = CONFIG.SubText,
            Font = Enum.Font.GothamMedium, TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
            ZIndex = 102,
        }, card)

        local progBg = new("Frame", {
            Size = UDim2.new(1, -12, 0, 2),
            Position = UDim2.new(0, 6, 1, -5),
            BackgroundColor3 = Color3.fromRGB(30, 26, 50),
            BorderSizePixel = 0, ZIndex = 102,
        }, card)
        corner(progBg, 1)
        local progFill = new("Frame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = color,
            BorderSizePixel = 0, ZIndex = 103,
        }, progBg)
        corner(progFill, 1)

        -- spring slide-in
        anim(card, "Position", UDim2.new(0, 0, 0, 0), 18)

        TweenService:Create(progFill, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
            Size = UDim2.new(0, 0, 1, 0),
        }):Play()

        task.delay(dur, function()
            pcall(function()
                anim(card, "Position", UDim2.new(1, 80, 0, 0), 16)
                TweenService:Create(card, TweenInfo.new(0.3), {
                    BackgroundTransparency = 1,
                }):Play()
                TweenService:Create(cardStroke, TweenInfo.new(0.3), {
                    Transparency = 1,
                }):Play()
                task.wait(0.35)
                card:Destroy()
            end)
        end)
    end)
end

local function notify(title, text, dur, color)
    pcall(function() toast(title, text, dur or 3, color) end)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title, Text = text, Duration = dur or 3,
        })
    end)
end


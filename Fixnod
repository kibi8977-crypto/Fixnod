local function fpsColor(fps)
    if fps < 30 then return COLOR_LOW
    elseif fps < 60 then return COLOR_MID
    else return COLOR_HIGH end
end

local function updateFpsDisplay()
    local fps = State.FPS
    local ping = State.Ping
    local col = fpsColor(fps)
    fpsBigLbl.Text = fps .. " FPS"
    anim(fpsBigLbl, "TextColor3", col, 8)
    anim(fpsBarFill, "BackgroundColor3", col, 8)
    anim(fpsBarFill, "Size", UDim2.new(math.clamp(fps / 120, 0, 1), 0, 1, 0), 8)

    fpsTopLbl.Text = "FPS: " .. fps
    anim(fpsTopLbl, "TextColor3", col, 8)
    pingSmallLbl.Text = "Ping: " .. (ping > 0 and (ping .. " ms") or "--")
    pingTopLbl.Text = "PING: " .. (ping > 0 and (ping .. " ms") or "--")

    for i = 1, CONFIG.GraphLen - 1 do
        FPSHistory[i] = FPSHistory[i + 1]
    end
    FPSHistory[CONFIG.GraphLen] = fps

    for i = 1, CONFIG.GraphLen do
        local v = FPSHistory[i]
        local bar = graphBars[i]
        if bar then
            local hRatio = math.clamp(v / 120, 0, 1)
            bar.BackgroundColor3 = fpsColor(v)
            bar.Size = UDim2.new(BAR_W, -1, 0, hRatio * 20)
        end
    end
end

local function fmtTime(sec)
    sec = math.floor(sec)
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local s = sec % 60
    return string.format("%02d:%02d:%02d", h, m, s)
end

local function updateSessionTimer()
    if sessionLbl and sessionLbl.Parent then
        sessionLbl.Text = fmtTime(now() - SESSION_START)
    end
end


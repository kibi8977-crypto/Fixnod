local function normalize(s)
    if not s then return "" end
    return string.lower(s):gsub("^%s+", ""):gsub("%s+$", "")
end

local function applySearch()
    local q = normalize(searchBox.Text)
    if q == "" then
        searchClearBtn.Visible = false
        for _, f in pairs(tabFrames) do
            for _, child in ipairs(f:GetChildren()) do
                if child:IsA("GuiObject") then child.Visible = true end
            end
        end
        return
    end
    searchClearBtn.Visible = true
    for _, f in pairs(tabFrames) do
        for _, child in ipairs(f:GetChildren()) do
            if child:IsA("GuiObject") then
                local label = child:GetAttribute("SearchLabel")
                if label then
                    child.Visible = (normalize(label):find(q, 1, true) ~= nil)
                end
            end
        end
    end
end


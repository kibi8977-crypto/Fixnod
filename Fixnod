        if d.dist then d.dist.TextColor3 = lighten(CONFIG.ESPColor, 0.15) end
        if d.tracer then d.tracer.BackgroundColor3 = CONFIG.ESPColor end
        for _, b in ipairs(d.bones) do b.BackgroundColor3 = CONFIG.ESPColor end
        if d.highlight then
            d.highlight.FillColor = CONFIG.ESPColor
            d.highlight.OutlineColor = lighten(CONFIG.ESPColor, 0.2)
        end
    end
end

local function setLine(frame, fromP, toP, thickness, color)
    local dx = toP.X - fromP.X
    local dy = toP.Y - fromP.Y
    local len = math.sqrt(dx*dx + dy*dy)
    if len < 1 then frame.Visible = false; return end
    frame.Size = UDim2.new(0, len, 0, math.max(thickness, 1))
    frame.Position = UDim2.new(0, (fromP.X+toP.X)*0.5, 0, (fromP.Y+toP.Y)*0.5)
    frame.Rotation = math.deg(math.atan2(dy, dx))
    frame.BackgroundColor3 = color
    frame.Visible = true
end

local function hidePlayerESP(d)
    for _, s in ipairs(d.corners) do s.Visible = false end
    d.name.Visible = false
    d.dist.Visible = false
    d.hpBg.Visible = false; d.hpFill.Visible = false
    d.tracer.Visible = false
    for _, b in ipairs(d.bones) do b.Visible = false end
    if d.highlight then pcall(function() d.highlight:Destroy() end); d.highlight = nil end
end

local function updatePlayerESP(plr, d)
    local cam = ESP_Camera
    if not cam then hidePlayerESP(d); return end

    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if not (State.ESP and plr ~= LocalPlayer and char and hrp and hum and hum.Health > 0) then
        hidePlayerESP(d); return
    end
    if State.ESPTeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
        hidePlayerESP(d); return
    end

    local dist = (cam.CFrame.Position - hrp.Position).Magnitude
    if dist > State.ESPMaxDist then hidePlayerESP(d); return end

    local cf, size = char:GetBoundingBox()
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local anyOn = false
    for xi = -1, 1, 2 do
        for yi = -1, 1, 2 do
            for zi = -1, 1, 2 do
                local wp = cf * Vector3.new(xi*size.X/2, yi*size.Y/2, zi*size.Z/2)
                local sp, on = cam:WorldToViewportPoint(wp)
                if on then
                    anyOn = true
                    if sp.X < minX then minX = sp.X end
                    if sp.Y < minY then minY = sp.Y end
                    if sp.X > maxX then maxX = sp.X end
                    if sp.Y > maxY then maxY = sp.Y end
                end
            end
        end
    end
    if not anyOn then hidePlayerESP(d); return end

    local w = maxX - minX
    local h = maxY - minY
    local vpSize = cam.ViewportSize
    local t = math.max(1, State.ESPThickness)
    local cLen = math.min(w, h) * (State.ESPCornerLen / 100)

    if State.ESPBox then
        local function setSeg(idx, x, y, sw, sh)
            local s = d.corners[idx]
            s.Visible = true
            s.Position = UDim2.new(0, x, 0, y)
            s.Size = UDim2.new(0, sw, 0, sh)
        end
        setSeg(1, minX, minY, cLen, t)
        setSeg(2, minX, minY, t, cLen)
        setSeg(3, maxX - cLen, minY, cLen, t)
        setSeg(4, maxX - t, minY, t, cLen)
        setSeg(5, minX, maxY - t, cLen, t)
        setSeg(6, minX, maxY - cLen, t, cLen)
        setSeg(7, maxX - cLen, maxY - t, cLen, t)
        setSeg(8, maxX - t, maxY - cLen, t, cLen)
    else
        for _, s in ipairs(d.corners) do s.Visible = false end
    end

    if State.ESPName then
        d.name.Visible = true
        d.name.Text = plr.Name
        d.name.Position = UDim2.new(0, minX + w*0.5, 0, minY - 4)
        if not State.ESPGalaxyName then d.name.TextColor3 = CONFIG.Text end
    else d.name.Visible = false end

    if State.ESPDistance then
        d.dist.Visible = true
        d.dist.Text = string.format("[%d m]", math.floor(dist))
        d.dist.Position = UDim2.new(0, minX + w*0.5, 0, maxY + 4)
    else d.dist.Visible = false end

    if State.ESPHealth and hum and hum.MaxHealth > 0 then
        local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        local barW = 3
        local barX = maxX + 4
        d.hpBg.Visible = true
        d.hpBg.Position = UDim2.new(0, barX, 0, minY)
        d.hpBg.Size = UDim2.new(0, barW, 0, h)
        local fH = h * ratio
        d.hpFill.Visible = true
        d.hpFill.Position = UDim2.new(0, barX, 0, minY + (h - fH))
        d.hpFill.Size = UDim2.new(0, barW, 0, fH)
        d.hpFill.BackgroundColor3 = Color3.new(1 - ratio, ratio, 0.3)
    else d.hpBg.Visible = false; d.hpFill.Visible = false end

    if State.ESPTracer then
        setLine(d.tracer,
            Vector2.new(vpSize.X*0.5, vpSize.Y),
            Vector2.new(minX + w*0.5, maxY),
            t, CONFIG.ESPColor)
    else d.tracer.Visible = false end

    if State.ESPSkeleton then
        local rig = (hum.RigType == Enum.HumanoidRigType.R15) and BONES_R15 or BONES_R6
        local i = 0
        for _, pair in ipairs(rig) do
            local a = char:FindFirstChild(pair[1])
            local b = char:FindFirstChild(pair[2])
            if a and b then
                i = i + 1
                local d1 = d.bones[i]
                if d1 then
                    local pa, oa = cam:WorldToViewportPoint(a.Position)
                    local pb, ob = cam:WorldToViewportPoint(b.Position)
                    if oa and ob then
                        setLine(d1,
                            Vector2.new(pa.X, pa.Y),
                            Vector2.new(pb.X, pb.Y),
                            math.max(1, t-1), CONFIG.ESPColor)
                    else d1.Visible = false end
                end
            end
        end
        for j = i + 1, #d.bones do d.bones[j].Visible = false end
    else
        for _, b in ipairs(d.bones) do b.Visible = false end
    end

    if State.ESPChams then
        if not d.highlight or d.highlight.Parent ~= char then
            if d.highlight then pcall(function() d.highlight:Destroy() end) end
            local hl = Instance.new("Highlight")
            hl.Name = "GalaxyESP"
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillTransparency = 0.55
            hl.OutlineTransparency = 0
            hl.FillColor = CONFIG.ESPColor
            hl.OutlineColor = lighten(CONFIG.ESPColor, 0.2)
            hl.Adornee = char
            hl.Parent = char
            d.highlight = hl
        else
            d.highlight.FillColor = CONFIG.ESPColor
            d.highlight.OutlineColor = lighten(CONFIG.ESPColor, 0.2)
        end
    else
        if d.highlight then pcall(function() d.highlight:Destroy() end); d.highlight = nil end
    end
end


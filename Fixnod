local function makeSlider(parent, label, min, max, default, key, callback, colorOverride, desc)
    local row = new("Frame", {
        Size = UDim2.new(1, -6, 0, 48),
        BackgroundColor3 = CONFIG.Panel,
        BorderSizePixel = 0, ZIndex = 3,
    }, parent)
    corner(row, 7)
    row:SetAttribute("SearchLabel", label)
    local rowStroke = stroke(row, COLOR_PANEL_STROKE, 1, 0.5)

    new("TextLabel", {
        Size = UDim2.new(1, -70, 0, 14),
        Position = UDim2.new(0, 12, 0, 3), BackgroundTransparency = 1,
        Text = label, TextColor3 = CONFIG.Text,
        Font = Enum.Font.GothamSemibold, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4,
    }, row)

    local valLbl = new("TextLabel", {
        Size = UDim2.new(0, 55, 0, 14),
        Position = UDim2.new(1, -66, 0, 3), BackgroundTransparency = 1,
        Text = tostring(default), TextColor3 = colorOverride or CONFIG.Accent2,
        Font = Enum.Font.GothamBold, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 4,
    }, row)
    if not colorOverride then bindAccent2(valLbl, "TextColor3") end

    local bar = new("Frame", {
        Size = UDim2.new(1, -24, 0, 5),
        Position = UDim2.new(0, 12, 0, 30),
        BackgroundColor3 = Color3.fromRGB(36,30,62),
        BorderSizePixel = 0, ZIndex = 4,
    }, row)
    corner(bar, 3)

    local fill = new("Frame", {
        Size = UDim2.new((default - min)/(max-min), 0, 1, 0),
        BackgroundColor3 = colorOverride or CONFIG.Accent,
        BorderSizePixel = 0, ZIndex = 4,
    }, bar)
    corner(fill, 3)

    if colorOverride then
        new("UIGradient", {
            Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, colorOverride),
                ColorSequenceKeypoint.new(1, lighten(colorOverride, 0.25)),
            },
            Rotation = 0,
        }, fill)
    else
        local fg = new("UIGradient", {
            Color = makeTriGradient(CONFIG.Accent, CONFIG.Accent2),
            Rotation = 0,
        }, fill)
        bindGradientFill(fg)
    end

    local knob = new("Frame", {
        Size = UDim2.new(0, 11, 0, 11),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((default - min)/(max-min), 0, 0.5, 0),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BorderSizePixel = 0, ZIndex = 5,
    }, bar)
    corner(knob, 6)
    stroke(knob, CONFIG.Accent, 1.4, 0.4)

    local dragging = false
    local hit = new("TextButton", {
        Size = UDim2.new(1, 0, 3, 0),
        Position = UDim2.new(0, 0, 0, -10),
        BackgroundTransparency = 1, Text = "", ZIndex = 5,
    }, bar)

    local function setVal(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = min + (max - min) * rel
        v = math.floor(v + 0.5)
        State[key] = v
        valLbl.Text = tostring(v)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        if callback then callback(v) end
    end

    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; setVal(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then setVal(i.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)

    attachHover(row, rowStroke)
    pcall(function() attachTooltip(row, label, desc or (min .. " -> " .. max)) end)
    return row
end

local function makeButton(parent, label, color, callback)
    local btn = new("TextButton", {
        Size = UDim2.new(1, -6, 0, 34),
